# ---------------------------------------------------------------------------
# Copy to `.env.local` for local dev. In Kubernetes these are supplied as
# Secret/ConfigMap-backed environment variables. Nothing here is read at build
# time except where noted — the app is configured at runtime.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Local dev with the bundled docker-compose Postgres:
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# GitHub Personal Access Token used to fetch the stats section.
# Needs `read:user` and `public_repo` (classic) or equivalent fine-grained scopes.
# Without it, the GitHub section degrades gracefully to a placeholder.
GITHUB_TOKEN=

# Secret used to sign the admin session cookie (any long random string).
# Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Seed admin credentials — consumed only by `bun run db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
